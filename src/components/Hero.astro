      </a>
      <a href="https://www.linkedin.com/in/diego-gongora-p" target="_blank" rel="noopener noreferrer"
         class="social-icon text-muted hover:text-accent transition-colors duration-200"
         aria-label="LinkedIn">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      </a>
      <a href="mailto:diego.gp227@gmail.com"
         class="social-icon text-muted hover:text-accent transition-colors duration-200"
         aria-label="Email">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
      </a>
      <span class="text-muted font-mono text-xs tracking-wide ml-2">diego.gp227@gmail.com</span>
    </div>
  </div>

  <div class="hero-right z-10 flex justify-center items-center reveal reveal-delay-2">
    <div class="avatar-wrap">
      <div class="avatar-bg absolute inset-0"></div>
      <div class="avatar-img">
        <img src="/Me.png" alt="Diego Gongora" />
      </div>
      <div class="avatar-badge absolute bottom-5 right-0 bg-surface border border-border px-5 py-3.5 backdrop-blur-sm">
        <div class="text-4xl font-extrabold text-accent leading-none">+3</div>
        <div class="font-mono text-[11px] text-muted tracking-widest uppercase mt-1">años de experiencia</div>
      </div>
    </div>
  </div>

  <div class="hero-scroll absolute bottom-10 left-15 flex items-center gap-4 font-mono text-[11px] text-muted tracking-widest uppercase">
    <div class="scroll-line"></div>
    Scroll
  </div>
</section>
